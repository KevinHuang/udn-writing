# 聯合報雲寫作教室 — 環境變數
#
# 這個檔案進版控，只放說明與範例值，**不要填真的密鑰**。
# 複製成 .env 並填入實際值。.env 不進版控。
#
# 變數名稱對齊 legacy-server 既有的用法（該目錄要在 Phase 1 搬成 apps/api）。
# Phase 1 完成後，legacy-server/.env.development 的內容合併到這裡，只留一份。
#
# ⚠️ 這裡的值全部只給後端。Vite 只會把 VITE_ 開頭的變數送進瀏覽器，
#    所以下面任何一個都不可以加 VITE_ 前綴。

# ─────────────────────────────────────────────
# 資料庫（pg-promise 用分開的欄位，不是連線字串）
# ─────────────────────────────────────────────
#
# ⛔ writing_classroom 是 **production**，有線上使用者正在使用。
#    開發與測試絕對不要指向它。
#
#    同一台主機上有三個資料庫：
#      writing_classroom           production —— 不要碰
#      writing_classroom_test      開發用（DB_NAME）
#      writing_classroom_autotest  自動化測試用（TEST_DB_NAME，會被清空）
#
#    apps/api 的 src/dal/database.ts 有一道防護：DB_NAME 指向 production 而
#    NODE_ENV 不是 production 時，啟動就會拋錯。不要為了方便繞過它。

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# 【自動化測試用】同一台主機上的**另一個、全新且空的** database。
#
# 需要先建立：createdb writing_classroom_autotest
#
# ⚠️ 測試每個案例前會清空資料表再塞自己的 fixtures，否則案例之間互相污染、
#    結果不可重複。**指到有既有資料的庫，第一次跑就會把資料清光。**
#    程式啟動時要檢查 TEST_DB_NAME !== DB_NAME，相同就拒絕執行測試。
#
# 為什麼不用交易回滾或另開 schema 來避免清空：兩者在這份程式碼上都要先付
# 一筆重構的錢 —— DAL 有 71 處直接呼叫 module-level 的 db.default（回滾要注入
# 交易物件），且 SQL 裡有 38 處寫死 public. 前綴（search_path 對它們無效）。
# 另開一個空庫只要一行 createdb。
#
# 既有的 writing_classroom_test 不受影響，留給人工驗證用。
TEST_DB_NAME=

# ─────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────

# koa-session 的簽章金鑰（app.keys）。
# ⚠️ 目前寫死在 legacy-server/src/index.ts，要搬出來並輪替。
# 產生方式：openssl rand -base64 48
SESSION_KEY=

# 留空則用既有預設值。
SESSION_COOKIE_NAME=@1campus_writing_classroom
SESSION_MAX_AGE_MS=28800000

# ─────────────────────────────────────────────
# 1Campus OAuth 2.0（不是 OIDC，詳見 docs/auth.md）
# ─────────────────────────────────────────────
#
# 同一組憑證給兩個流程共用：
#   A. 使用者登入   → Authorization Code
#   B. 校務資料同步 → Client Credentials（DevAPI）

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# 必須與 1Campus 註冊的完全一致。開發環境是 http://localhost:3001/auth/callback
OAUTH_REDIRECT_URI=

# 登入完成後導回哪裡。
CLIENT_HOME_PAGE=http://localhost:3000/

# ⚠️ 既有的 CORS 設定只讀 CLIENT_HOME_PAGE，這個變數目前是**死設定**
#    （src/index.ts 裡使用它的那段是註解掉的）。
#    決定「後端 serve 前端、同源部署」之後，CORS 應該整個拿掉。
ALLOWED_ORIGINS=

# 以下四項目前**寫死在 legacy-server/src/config.ts**，列在這裡是為了
# (a) 讓設定可見 (b) 之後改成可覆寫。值是既有實作正在用的。
OAUTH_AUTHORIZE_URL=https://auth.ischool.com.tw/oauth/authorize.php
OAUTH_TOKEN_URL=https://auth.ischool.com.tw/oauth/token.php
OAUTH_USERINFO_URL=https://auth.ischool.com.tw/services/me.php
OAUTH_SCOPE=User.Mail,User.BasicInfo,User.Application

# ─────────────────────────────────────────────
# 校務資料 DevAPI
# ─────────────────────────────────────────────

DEVAPI_HOST=https://devapi.1campus.net

# 同時也是 URL 路徑的一段：/api/{scope}/{schoolDsns}/getClass
DEVAPI_SCOPE=jasmine

# ─────────────────────────────────────────────
# GenAI — 走 Vertex AI，不是 API 金鑰
# ─────────────────────────────────────────────
#
# ⚠️ legacy-server/.env.development 裡這三行寫成 `KEY: value`（冒號），
#    dotenv 只認 `KEY=value`，所以它們**從來沒有生效過**。
#    這裡一律用等號。

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# service account 金鑰的路徑。
# ⚠️ legacy-server/writing-classroom-gcs-key.json 是一把有效的私鑰，
#    已被 .gitignore 擋下，但**應該輪替**。
#    Cloud Run 上不需要這個檔，用附掛的 service account 即可。
GOOGLE_APPLICATION_CREDENTIALS=

OCR_MODEL=gemini-3.1-pro-preview
GRADING_MODEL=gemini-3.7-flash

# ─────────────────────────────────────────────
# Cloud Storage
# ─────────────────────────────────────────────

STORAGE_BUCKET_NAME=1campus-storage
STORAGE_API_URL=https://storage.googleapis.com/upload/storage/v1/b/1campus-storage/o

# ─────────────────────────────────────────────
# 服務
# ─────────────────────────────────────────────

# development / production
NODE_ENV=development

# 後端 port（既有實作讀的是 PORT，不是 API_PORT）
PORT=3001
