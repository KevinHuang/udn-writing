{
  "name": "udn-writing-classroom",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @udn/web",
    "dev:api": "npm run dev -w @udn/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    
    "deploy": "npm run deploy:build && npm run deploy:run",
    "deploy:build": "gcloud builds submit --config cloudbuild.yaml --project=writing-classroom-672f8",
    "deploy:run": "gcloud run deploy udn-writing-test --project=writing-classroom-672f8 --region=asia-east1 --image=asia-east1-docker.pkg.dev/writing-classroom-672f8/writing-classroom-repo/udn-writing-test:latest --platform=managed --allow-unauthenticated --memory=1Gi --cpu=1 --timeout=300 --max-instances=3",
    "deploy:smoke": "gcloud run services describe udn-writing-test --project=writing-classroom-672f8 --region=asia-east1 --format='value(status.url)' | xargs -I{} bash scripts/smoke.sh {}"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
